   ],
   "lines": [
    {
     "bbox": [
      118,
      800,
      1122,
      839
     ],
     "text": "Bên cạnh nhịp sống hiện đại, thành phốcòn giữnhiều dấu ấn lịch sử. Ẩm thực cũng",
     "size": 14.1,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      118,
      838,
      1122,
      878
     ],
     "text": "là một nét đặc sắc, từbánh mì, cơm tấm đến các món ăn vặt vỉa hè, phản ánh sựđa",
     "size": 14.1,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      118,
      877,
