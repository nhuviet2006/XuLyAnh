     ],
     "text": "Thành phốHồChí Minh là trung tâm kinh tế, văn hóa và khoa học lớn nhất của Việt",
     "size": 14.1,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      118,
      667,
      1122,
      707
     ],
     "text": "Nam. Thành phốnằm ởmiền Nam, bên bờsông Sài Gòn, với khí hậu nhiệt đới gió",
     "size": 14.1,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      118,
      706,
      1122,
      745
     ],
     "text": "mùa quanh năm. Nhịp sống nhộn nhịp cùng nhiều trường đại học và khu công nghệ",
     "size": 14.1,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      118,
      744,
      797,
      784
     ],
     "text": "khiến nơi đây thu hút đông đảo người trẻtừkhắp cảnước.",
     "size": 14.1,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
